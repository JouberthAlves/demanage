NODE_ENV="development"
# Local: API_PORT. Em Docker/PaaS a plataforma costuma injetar PORT (tem prioridade).
API_PORT=8888

# URL exata do frontend (CORS + detecção de cookie cross-site).
# Em production o host deve bater exatamente com o navegador.
# Em development, localhost, IPs privados da LAN e *.local também são aceitos
# para facilitar testes pelo celular na mesma rede.
APP_URL="http://localhost:5180"

DATABASE_URL="postgresql://demanage:demanage@localhost:5432/demanage?schema=public"

# Em production é obrigatório (sem fallback)
JWT_SECRET="demanage-dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Opcional: força cookie SameSite. Vazio = auto
# (em production, se host do APP_URL ≠ host da API → none + Secure)
# COOKIE_SAME_SITE="none"

# Integração MCP financeira: desabilitada por padrão. Veja docs/mcp-finance-setup.md.
# Não habilite em produção sem revisão, autorização e segredos independentes.
# MCP_ENABLED=false
# MCP_RESOURCE_URL="https://SEU-DOMINIO/api/mcp"
# MCP_ISSUER_URL="https://SEU-DOMINIO/api/oauth"
# MCP_INTENT_SECRET="SEGREDO_ALEATORIO_32_BYTES_OU_MAIS"
# MCP_OAUTH_COOKIE_KEYS="SEGREDO_ALEATORIO_INDEPENDENTE_32_BYTES_OU_MAIS"
# MCP_OAUTH_JWKS='{"keys":["INSERIR_JWK_PRIVADA_SEGURA_FORA_DO_GIT"]}'
# MCP_OAUTH_CLIENT_HOSTS="HOSTS_EXATOS_DOS_CLIENTES_CIMD_PERMITIDOS"
