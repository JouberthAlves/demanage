NODE_ENV="development"
# Local: API_PORT. Em Docker/Railway a plataforma costuma injetar PORT (tem prioridade).
API_PORT=8888

# URL exata do frontend (CORS + detecção de cookie cross-site)
# Sem barra final; host deve bater com o que o browser usa.
APP_URL="http://localhost:5180"

DATABASE_URL="postgresql://demanage:demanage@localhost:5432/demanage?schema=public"

# Em production é obrigatório (sem fallback)
JWT_SECRET="demanage-dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Opcional: força cookie SameSite. Vazio = auto
# (em production, se host do APP_URL ≠ host da API → none + Secure)
# COOKIE_SAME_SITE="none"
