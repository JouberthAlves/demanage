    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0"
