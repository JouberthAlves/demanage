generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

// Database-level rules that Prisma cannot express are added by raw SQL in
// prisma/migrations (keep this file and those migrations in sync):
//   - ExpenseSplit: partial unique index for rows without a card (pix),
//     because @@unique([expenseId, kind, cardId]) ignores NULL cardId.
//   - Card.closingDay / Card.pendingClosingDay, Entry.receiveDay,
//     PiggyBank.autoDebitDay: CHECK constraints restricting values to 1..31.
// `prisma migrate diff` (CI drift gate) compares migrations against this
// file; those objects are created by migrations and must not be removed here.
datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  assinatura
  parcela
  divida
  outro
  cofrinho
  investimento
}

enum ExpenseFrequency {
  mensal
  semanal
  unica
}

enum EntryType {
  salario
  freelance
  outro
}

enum EntryFrequency {
  mensal
  semanal
  unica
}

enum CustomTagScope {
  expense
  income
}

enum PiggyTransactionType {
  deposit
  withdraw
  interest
}

enum PiggyTransactionSource {
  manual
  auto_debit
  yield
}

enum ExpenseSplitKind {
  card
  pix
}

enum LedgerOrigin {
  manual
  piggy
  asset
}

enum Asset {
  BTC
  USD
}

enum AssetTransactionType {
  BUY
  SELL
  MANUAL_ADJUSTMENT
}

model User {
  id                    String             @id @default(uuid())
  name                  String
  email                 String             @unique
  passwordHash          String
  recoveryCodeHash      String?
  recoveryCodeCreatedAt DateTime?
  sessionVersion        Int                @default(0)
  salary                Decimal            @default(0) @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  cards                 Card[]
  expenses              Expense[]
  entries               Entry[]
  customTags            CustomTag[]
  piggyBanks            PiggyBank[]
  piggyTransactions     PiggyTransaction[]
  assetTransactions     AssetTransaction[]
  patrimonySettings     PatrimonySettings?
}

model Card {
  id                     String         @id @default(uuid())
  userId                 String
  name                   String
  limit                  Decimal?       @db.Decimal(12, 2)
  closingDay             Int
  pendingClosingDay      Int?
  pendingClosingDaySetAt DateTime?
  minimumNextClosingOn   DateTime?
  archivedAt             DateTime?
  expiresAt              DateTime?
  lastInvoicedOn         DateTime?
  lastBillingProcessedAt DateTime?      @default(now())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses               Expense[]
  expenseSplits          ExpenseSplit[]

  @@index([userId])
}

model CustomTag {
  id        String         @id @default(uuid())
  userId    String
  scope     CustomTagScope
  name      String
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  entries   Entry[]

  // The unique below also serves (userId, scope) lookups.
  @@unique([userId, scope, name])
}

model Expense {
  id                 String            @id @default(uuid())
  userId             String
  cardId             String?
  customTagId        String?
  name               String
  amount             Decimal           @db.Decimal(12, 2)
  category           ExpenseCategory
  frequency          ExpenseFrequency  @default(mensal)
  dueDay             Int?
  startsAt           DateTime?
  endsAt             DateTime?
  occurredAt         DateTime?
  paidForMonth       String?
  paidAt             DateTime?
  notes              String?
  isInvoice          Boolean           @default(false)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  archivedAt         DateTime?
  systemOrigin       LedgerOrigin      @default(manual)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  card               Card?             @relation(fields: [cardId], references: [id], onDelete: SetNull)
  customTag          CustomTag?        @relation(fields: [customTagId], references: [id], onDelete: SetNull)
  splits             ExpenseSplit[]
  assetTransaction   AssetTransaction?
  payments           ExpensePayment[]
  piggyTransactions  PiggyTransaction[]

  // Leading-userId composites below also serve userId-only lookups.
  @@index([cardId])
  @@index([customTagId])
  @@index([userId, occurredAt])
  @@index([userId, archivedAt])
}

model ExpenseSplit {
  id        String           @id @default(uuid())
  expenseId String
  kind      ExpenseSplitKind
  cardId    String?
  percent   Decimal          @db.Decimal(5, 2)
  amount    Decimal          @db.Decimal(12, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  expense   Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  card      Card?            @relation(fields: [cardId], references: [id], onDelete: Restrict)

  // @@unique ignores NULL cardId (pix rows), so the migration adds a partial
  // unique index: UNIQUE (expenseId, kind) WHERE cardId IS NULL.
  @@unique([expenseId, kind, cardId])
  @@index([cardId])
}

model ExpensePayment {
  id        String   @id @default(uuid())
  expenseId String
  month     String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([expenseId, month])
}

model Entry {
  id                  String            @id @default(uuid())
  userId              String
  customTagId         String?
  name                String
  amount              Decimal           @db.Decimal(12, 2)
  type                EntryType
  frequency           EntryFrequency
  receiveDay          Int?
  startsAt            DateTime?
  endsAt              DateTime?
  date                DateTime?
  receiptHoldForMonth String?
  receivedForMonth    String?
  receivedAt          DateTime?
  archivedAt          DateTime?
  systemOrigin        LedgerOrigin      @default(manual)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customTag           CustomTag?        @relation(fields: [customTagId], references: [id], onDelete: SetNull)
  assetTransaction    AssetTransaction?
  receipts            EntryReceipt[]
  piggyTransactions   PiggyTransaction[]

  // Leading-userId composite below also serves userId-only lookups.
  @@index([customTagId])
  @@index([userId, archivedAt])
}

model EntryReceipt {
  id         String   @id @default(uuid())
  entryId    String
  month      String
  amount     Decimal  @db.Decimal(12, 2)
  receivedAt DateTime
  createdAt  DateTime @default(now())
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([entryId, month])
}

model PiggyBank {
  id                     String             @id @default(uuid())
  userId                 String
  name                   String
  goalAmount             Decimal?           @db.Decimal(12, 2)
  targetDate             DateTime?
  monthlyGoal            Decimal            @default(0) @db.Decimal(12, 2)
  autoDebit              Boolean            @default(false)
  autoDebitDay           Int                @default(1)
  // Instant auto-debit was last switched on (null while off). Cycles before it
  // are never back-filled.
  autoDebitEnabledAt     DateTime?
  isEmergency            Boolean            @default(false)
  yieldEnabled           Boolean            @default(false)
  cdiPercent             Decimal            @default(0) @db.Decimal(8, 4)
  interestAccruedThrough DateTime?
  archivedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           PiggyTransaction[]

  // Leading-userId composite below also serves userId-only lookups.
  @@index([userId, archivedAt])
}

model PiggyTransaction {
  id               String                 @id @default(uuid())
  piggyBankId      String
  userId           String
  type             PiggyTransactionType
  source           PiggyTransactionSource @default(manual)
  amount           Decimal                @db.Decimal(12, 2)
  date             DateTime
  expenseId        String?
  entryId          String?
  note             String?
  cdiRate          Decimal?               @db.Decimal(12, 8)
  cdiPercent       Decimal?               @db.Decimal(8, 4)
  baseBalance      Decimal?               @db.Decimal(18, 8)
  resultingBalance Decimal?               @db.Decimal(18, 8)
  interestKey      String?                @unique
  createdAt        DateTime               @default(now())
  piggyBank        PiggyBank              @relation(fields: [piggyBankId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense          Expense?               @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  entry            Entry?                 @relation(fields: [entryId], references: [id], onDelete: SetNull)

  // Leading-piggyBankId composite below also serves piggyBankId-only lookups.
  @@index([userId])
  @@index([expenseId])
  @@index([entryId])
  @@index([piggyBankId, type, source, date])
}

model PatrimonySettings {
  id             String   @id @default(uuid())
  userId         String   @unique
  baseDate       DateTime
  openingCashBrl Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssetTransaction {
  id             String               @id @default(uuid())
  userId         String
  asset          Asset
  type           AssetTransactionType
  quantity       Decimal              @db.Decimal(30, 12)
  cashAmountBrl  Decimal              @db.Decimal(18, 8)
  feeAmountBrl   Decimal              @default(0) @db.Decimal(18, 8)
  feePercent     Decimal?             @db.Decimal(12, 8)
  costBasisKnown Boolean              @default(true)
  date           DateTime
  note           String?
  expenseId      String?              @unique
  entryId        String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense        Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  entry          Entry?               @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([userId, asset, date])
}

model MarketDataCache {
  id        String   @id @default(uuid())
  provider  String
  key       String
  at        DateTime
  value     Decimal  @db.Decimal(30, 12)
  fetchedAt DateTime @default(now())

  @@unique([provider, key, at])
}
