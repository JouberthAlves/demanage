generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseCategory {
  assinatura
  parcela
  divida
  outro
  cofrinho
  investimento
}

enum ExpenseFrequency {
  mensal
  semanal
  unica
}

enum EntryType {
  salario
  freelance
  outro
}

enum EntryFrequency {
  mensal
  semanal
  unica
}

enum CustomTagScope {
  expense
  income
}

enum PiggyTransactionType {
  deposit
  withdraw
  interest
}

enum PiggyTransactionSource {
  manual
  auto_debit
  yield
}

enum ExpenseSplitKind {
  card
  pix
}

enum Asset {
  BTC
  USD
}

enum AssetTransactionType {
  BUY
  SELL
  MANUAL_ADJUSTMENT
}

model User {
  id                    String   @id @default(uuid())
  name                  String
  email                 String   @unique
  passwordHash          String
  recoveryCodeHash      String?
  recoveryCodeCreatedAt DateTime?
  sessionVersion        Int      @default(0)
  salary                Decimal  @default(0) @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  cards                  Card[]
  expenses               Expense[]
  entries                Entry[]
  customTags             CustomTag[]
  piggyBanks             PiggyBank[]
  assetTransactions      AssetTransaction[]
  patrimonySettings      PatrimonySettings?
}

model Card {
  id             String         @id @default(uuid())
  userId         String
  name           String
  limit          Decimal?       @db.Decimal(12, 2)
  closingDay     Int
  expiresAt      DateTime?
  lastInvoicedOn DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  expenseSplits  ExpenseSplit[]

  @@index([userId])
}

model CustomTag {
  id        String         @id @default(uuid())
  userId    String
  scope     CustomTagScope
  name      String
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  entries   Entry[]

  @@unique([userId, scope, name])
  @@index([userId, scope])
}

model Expense {
  id               String           @id @default(uuid())
  userId           String
  cardId           String?
  customTagId      String?
  name             String
  amount           Decimal          @db.Decimal(12, 2)
  category         ExpenseCategory
  frequency        ExpenseFrequency @default(mensal)
  dueDay           Int?
  startsAt         DateTime?
  endsAt           DateTime?
  occurredAt       DateTime?
  notes            String?
  isInvoice        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  card             Card?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  customTag        CustomTag?        @relation(fields: [customTagId], references: [id], onDelete: SetNull)
  splits           ExpenseSplit[]
  assetTransaction AssetTransaction?

  @@index([userId])
  @@index([cardId])
  @@index([customTagId])
  @@index([userId, occurredAt])
}

model ExpenseSplit {
  id        String           @id @default(uuid())
  expenseId String
  kind      ExpenseSplitKind
  cardId    String?
  percent   Decimal          @db.Decimal(5, 2)
  amount    Decimal          @db.Decimal(12, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  expense   Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  card      Card?            @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([expenseId, kind, cardId])
  @@index([expenseId])
  @@index([cardId])
}

model Entry {
  id               String         @id @default(uuid())
  userId           String
  customTagId      String?
  name             String
  amount           Decimal        @db.Decimal(12, 2)
  type             EntryType
  frequency        EntryFrequency
  receiveDay       Int?
  startsAt         DateTime?
  endsAt           DateTime?
  date             DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customTag        CustomTag?      @relation(fields: [customTagId], references: [id], onDelete: SetNull)
  assetTransaction AssetTransaction?

  @@index([userId])
  @@index([customTagId])
}

model PiggyBank {
  id                     String             @id @default(uuid())
  userId                 String
  name                   String
  goalAmount             Decimal?           @db.Decimal(12, 2)
  targetDate             DateTime?
  monthlyGoal            Decimal            @db.Decimal(12, 2) @default(0)
  autoDebit              Boolean            @default(false)
  autoDebitDay           Int                @default(1)
  isEmergency            Boolean            @default(false)
  yieldEnabled           Boolean            @default(false)
  cdiPercent             Decimal            @db.Decimal(8, 4) @default(0)
  interestAccruedThrough DateTime?
  archivedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           PiggyTransaction[]

  @@index([userId])
  @@index([userId, archivedAt])
}

model PiggyTransaction {
  id               String                 @id @default(uuid())
  piggyBankId      String
  userId           String
  type             PiggyTransactionType
  source           PiggyTransactionSource @default(manual)
  amount           Decimal                @db.Decimal(12, 2)
  date             DateTime
  expenseId        String?
  entryId          String?
  note             String?
  cdiRate          Decimal?               @db.Decimal(12, 8)
  cdiPercent       Decimal?               @db.Decimal(8, 4)
  baseBalance      Decimal?               @db.Decimal(18, 8)
  resultingBalance Decimal?               @db.Decimal(18, 8)
  interestKey      String?                @unique
  createdAt        DateTime               @default(now())
  piggyBank        PiggyBank              @relation(fields: [piggyBankId], references: [id], onDelete: Cascade)

  @@index([piggyBankId])
  @@index([userId])
  @@index([piggyBankId, type, source, date])
}

model PatrimonySettings {
  id             String   @id @default(uuid())
  userId         String   @unique
  baseDate       DateTime
  openingCashBrl Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssetTransaction {
  id             String               @id @default(uuid())
  userId         String
  asset          Asset
  type           AssetTransactionType
  quantity       Decimal              @db.Decimal(30, 12)
  cashAmountBrl  Decimal              @db.Decimal(18, 8)
  feeAmountBrl   Decimal              @db.Decimal(18, 8) @default(0)
  feePercent     Decimal?             @db.Decimal(12, 8)
  costBasisKnown Boolean              @default(true)
  date           DateTime
  note           String?
  expenseId      String?              @unique
  entryId        String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense        Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  entry          Entry?               @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([userId, asset, date])
}

model MarketDataCache {
  id        String   @id @default(uuid())
  provider  String
  key       String
  at        DateTime
  value     Decimal  @db.Decimal(30, 12)
  fetchedAt DateTime @default(now())

  @@unique([provider, key, at])
  @@index([provider, key, at])
}
