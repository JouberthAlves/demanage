generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseCategory {
  assinatura
  parcela
  divida
  outro
}

enum ExpenseFrequency {
  mensal
}

enum EntryType {
  salario
  freelance
  outro
}

enum EntryFrequency {
  mensal
  unica
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  salary       Decimal   @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cards        Card[]
  expenses     Expense[]
  entries      Entry[]
}

model Card {
  id         String    @id @default(uuid())
  userId     String
  name       String
  limit      Decimal?  @db.Decimal(12, 2)
  closingDay Int?
  dueDay     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses   Expense[]

  @@index([userId])
}

model Expense {
  id        String           @id @default(uuid())
  userId    String
  cardId    String?
  name      String
  amount    Decimal          @db.Decimal(12, 2)
  category  ExpenseCategory
  frequency ExpenseFrequency @default(mensal)
  dueDay    Int?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      Card?            @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cardId])
}

model Entry {
  id        String         @id @default(uuid())
  userId    String
  name      String
  amount    Decimal        @db.Decimal(12, 2)
  type      EntryType
  frequency EntryFrequency
  date      DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
