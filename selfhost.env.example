# Copie este arquivo para .env na raiz antes de subir docker-compose.prod.yml.
# .env já é ignorado pelo Git.

APP_URL=https://demanage.biel.dev.br
DEMANAGE_PORT=8080
VITE_API_URL=/api

# Mantenha 0; use 1 somente se o Cloudflare Tunnel for a única entrada externa.
TRUST_CF_CONNECTING_IP=0

# Use somente caracteres URL-safe aqui (hex é recomendado), pois a senha entra na DATABASE_URL.
POSTGRES_PASSWORD=troque-por-64-caracteres-hex-aleatorios

# Em production não existe fallback. Use um segredo aleatório longo.
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRES_IN=7d
