# Copie este arquivo para .env na raiz antes de subir docker-compose.prod.yml.
# .env já é ignorado pelo Git.

APP_URL=https://demanage.biel.dev.br
DEMANAGE_PORT=8080

# Imagens publicadas no GHCR pelo workflow "Publish verified GHCR images".
# Use o digest completo (sha256) informado no resumo do workflow ou em production.json.
DEMANAGE_BACKEND_IMAGE=ghcr.io/bielxdh3/demanage-backend@sha256:troque-pelo-digest-completo
DEMANAGE_FRONTEND_IMAGE=ghcr.io/bielxdh3/demanage-frontend@sha256:troque-pelo-digest-completo

# Imagens de produção usam VITE_API_URL=/api (definido no build). Não altere aqui.
# Para self-host por build local, veja docker-compose.build.yml.

# Mantenha 0; use 1 somente se o Cloudflare Tunnel for a única entrada externa.
TRUST_CF_CONNECTING_IP=0

# Use somente caracteres URL-safe aqui (hex é recomendado), pois a senha entra na DATABASE_URL.
POSTGRES_PASSWORD=troque-por-64-caracteres-hex-aleatorios

# Em production não existe fallback. Use um segredo aleatório longo.
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRES_IN=7d
