[Unit]
Description=deManage approved image-only production deploy
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=biel
Group=biel
WorkingDirectory=/opt/demanage/cd
ExecStart=/usr/bin/python3 /opt/demanage/cd/deploy_agent.py --config /opt/demanage/cd/config.json
TimeoutStartSec=900
NoNewPrivileges=true
UMask=0077
