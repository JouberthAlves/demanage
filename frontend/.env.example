# Local: URL absoluta da API.
# Production (Railway, same-origin): VITE_API_URL=/api
# (nginx do front encaminha /api para o backend interno)
VITE_API_URL="http://localhost:8888"

# Development em outro dispositivo (ex.: celular na mesma Wi-Fi):
# se a API estiver configurada como localhost e a página for aberta por IP da LAN
# ou hostname *.local, o frontend troca apenas o host da API pelo host da página,
# preservando a porta. Ex.: http://192.168.0.10:5180 -> API :8888.

# Deploy tip:
# - Mesmo site (proxy): cookie SameSite=Lax funciona
# - FE e API em domínios diferentes: backend usa SameSite=None; Secure
#   (ou defina COOKIE_SAME_SITE=none no backend)
